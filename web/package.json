{
  "name": "kestrel-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && touch dist/.keep",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "fmt": "prettier --write src scripts",
    "fmt:check": "prettier --check src scripts",
    "chrome": "node scripts/chrome-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts"
  },
  "dependencies": {
    "@hyprsh/design": "github:hyprsh/design#v0.14.0",
    "@tanstack/react-query": "^5.104.4",
    "lucide-react": "^1.59.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "knip": "^6.39.0",
    "msw": "^3.0.3",
    "openapi-msw": "^2.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
