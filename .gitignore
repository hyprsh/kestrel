node_modules/

# Build output. web/dist/.keep stays so go:embed always has a directory.
/bin/
/web/dist/*
!/web/dist/.keep

# Local dev state (config dir with the SQLite database)
/.dev/

# GoReleaser output
/dist/
/release-assets/

# VitePress docs site output and cache
/web/docs-site/.vitepress/dist/
/web/docs-site/.vitepress/cache/
__pycache__/
