node_modules/

# Build output. web/dist/.keep stays so go:embed always has a directory.
/bin/
/web/dist/*
!/web/dist/.keep

# Local dev state (config dir with the SQLite database)
/.dev/

# GoReleaser output
/dist/
/release-assets/

# Left by the lefthook commit hook when it falls back to pnpm to find lefthook
/.build/
/pnpm-lock.yaml
/pnpm-workspace.yaml
